<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#c98fa6">
<title>Me To You Designs | Balloon Brain</title>
<style>
:root{
  --pink:#c98fa6; --dark:#29242a; --light:#fff8fb; --border:#ead9e0;
  --green:#3c8b68; --red:#b84f5d;
}
*{box-sizing:border-box}
body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#f7f2f5;color:var(--dark)}
header{background:linear-gradient(135deg,#c98fa6,#e8bfd0);color:white;padding:22px 18px 26px;position:sticky;top:0;z-index:5}
.logo{font-size:25px;font-weight:800}.sub{opacity:.9;margin-top:3px}
nav{display:flex;gap:8px;overflow:auto;margin-top:18px}
nav button{border:0;background:#ffffff30;color:white;padding:10px 13px;border-radius:999px;white-space:nowrap;font-weight:700}
nav button.active{background:white;color:var(--pink)}
main{max-width:900px;margin:auto;padding:18px}
.screen{display:none}.screen.active{display:block}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px}
.card{background:white;border:1px solid var(--border);border-radius:18px;padding:17px;box-shadow:0 4px 15px #5a33400d}
.card h3{margin:0 0 8px}.big{font-size:27px;font-weight:800}
label{display:block;font-weight:700;font-size:13px;margin:12px 0 5px}
input,select,textarea{width:100%;padding:12px;border:1px solid #dacbd2;border-radius:10px;background:white;font:inherit}
textarea{min-height:80px;resize:vertical}
button.primary{background:var(--pink);color:white;border:0;border-radius:11px;padding:13px 16px;font-weight:800;cursor:pointer}
button.secondary{background:#f2e6eb;color:var(--dark);border:0;border-radius:11px;padding:12px 15px;font-weight:700}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.result{background:#fff4f8;border:1px solid #edcfdb;border-radius:15px;padding:15px;margin-top:15px}
.row{display:flex;justify-content:space-between;gap:15px;margin:7px 0}.total{font-size:21px;font-weight:900;border-top:1px solid var(--border);padding-top:10px;margin-top:10px}
.small{font-size:12px;color:#766b72}
.danger{color:var(--red);font-weight:700}
.success{color:var(--green);font-weight:800}
.quote{white-space:pre-wrap;background:white;padding:18px;border-radius:14px;border:1px solid var(--border)}
@media print{
  body{background:white}.no-print,header,nav{display:none!important}
  main{padding:0}.screen{display:none!important}.screen.printable{display:block!important}
}
</style>
</head>
<body>
<header>
  <div class="logo">Me To You Designs 🎈</div>
  <div class="sub">Balloon Brain — your own business calculator</div>
  <nav class="no-print">
    <button class="active" onclick="show('dashboard',this)">Dashboard</button>
    <button onclick="show('calculator',this)">Calculator</button>
    <button onclick="show('quote',this)">Quote</button>
    <button onclick="show('jobs',this)">Jobs</button>
  </nav>
</header>

<main>
<section id="dashboard" class="screen active">
  <h2>Business Dashboard</h2>
  <div class="grid">
    <div class="card"><h3>Saved Quotes</h3><div class="big" id="quoteCount">0</div></div>
    <div class="card"><h3>Upcoming Jobs</h3><div class="big" id="jobCount">0</div></div>
    <div class="card"><h3>Quote Total</h3><div class="big" id="quoteTotal">£0.00</div></div>
  </div>
  <div class="card" style="margin-top:12px">
    <h3>Quick start</h3>
    <p>Use the calculator to work out balloon costs, selling price and profit. Save the result as a quote.</p>
    <button class="primary" onclick="show('calculator',document.querySelectorAll('nav button')[1])">Open Balloon Calculator</button>
  </div>
</section>

<section id="calculator" class="screen">
  <h2>🎈 Balloon Calculator</h2>
  <div class="card">
    <div class="grid">
      <div><label>Display type</label>
        <select id="type">
          <option>Number Stack</option><option>Half Arch</option><option>Full Arch</option>
          <option>Organic Arch</option><option>Classic Arch</option><option>Balloon Column</option>
          <option>Balloon Tower</option><option>Table Centre</option><option>Helium Balloons</option><option>Custom</option>
        </select>
      </div>
      <div><label>Number of balloons</label><input id="balloons" type="number" min="0" value="30"></div>
      <div><label>Cost per balloon (£)</label><input id="balloonCost" type="number" min="0" step=".01" value=".12"></div>
      <div><label>Foils / special balloons (£)</label><input id="foils" type="number" min="0" step=".01" value="0"></div>
      <div><label>Other materials (£)</label><input id="materials" type="number" min="0" step=".01" value="3"></div>
      <div><label>Your labour (£)</label><input id="labour" type="number" min="0" step=".01" value="20"></div>
      <div><label>Delivery / travel (£)</label><input id="delivery" type="number" min="0" step=".01" value="0"></div>
      <div><label>Other costs (£)</label><input id="other" type="number" min="0" step=".01" value="0"></div>
      <div><label>Desired profit margin (%)</label><input id="margin" type="number" min="0" max="95" step="1" value="40"></div>
    </div>
    <div class="actions"><button class="primary" onclick="calculate()">Calculate</button><button class="secondary" onclick="resetCalc()">Reset</button></div>
    <div id="calcResult" class="result" style="display:none"></div>
  </div>
</section>

<section id="quote" class="screen">
  <h2>🧾 Create Quote</h2>
  <div class="card">
    <div class="grid">
      <div><label>Customer name</label><input id="customer"></div>
      <div><label>Customer contact</label><input id="contact"></div>
      <div><label>Event date</label><input id="eventDate" type="date"></div>
      <div><label>Venue</label><input id="venue"></div>
      <div><label>Customer price (£)</label><input id="sellPrice" type="number" min="0" step=".01"></div>
      <div><label>Deposit (£)</label><input id="deposit" type="number" min="0" step=".01" value="0"></div>
    </div>
    <label>Quote notes</label><textarea id="notes" placeholder="Colours, theme, setup details, etc."></textarea>
    <div class="actions">
      <button class="primary" onclick="saveQuote()">Save Quote</button>
      <button class="secondary" onclick="makeQuoteText()">Preview Quote</button>
    </div>
    <div id="quotePreview" class="result" style="display:none"></div>
  </div>
</section>

<section id="jobs" class="screen">
  <h2>📅 Saved Quotes & Jobs</h2>
  <div id="jobsList"></div>
</section>
</main>

<script>
const key='mtyd_balloon_quotes_v1';
let quotes=JSON.parse(localStorage.getItem(key)||'[]');
let lastCalc=null;

function money(n){return '£'+Number(n||0).toFixed(2)}
function val(id){return Number(document.getElementById(id).value)||0}

function show(id,btn){
  document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));
  if(btn)btn.classList.add('active');
  if(id==='jobs')renderJobs();
  updateDash();
}

function calculate(){
  const balloons=val('balloons'), balloonCost=val('balloonCost');
  const balloonTotal=balloons*balloonCost;
  const cost=balloonTotal+val('foils')+val('materials')+val('labour')+val('delivery')+val('other');
  const margin=Math.min(95,val('margin'));
  const sell=cost/(1-margin/100);
  const profit=sell-cost;
  const result=document.getElementById('calcResult');
  lastCalc={type:document.getElementById('type').value,cost,sell,profit};
  result.style.display='block';
  result.innerHTML=`
    <div class="row"><span>Balloon materials</span><strong>${money(balloonTotal)}</strong></div>
    <div class="row"><span>Foils / special balloons</span><strong>${money(val('foils'))}</strong></div>
    <div class="row"><span>Other materials</span><strong>${money(val('materials'))}</strong></div>
    <div class="row"><span>Labour</span><strong>${money(val('labour'))}</strong></div>
    <div class="row"><span>Delivery / travel</span><strong>${money(val('delivery'))}</strong></div>
    <div class="row"><span>Other costs</span><strong>${money(val('other'))}</strong></div>
    <div class="row total"><span>Total cost</span><strong>${money(cost)}</strong></div>
    <div class="row"><span>Suggested customer price</span><strong>${money(sell)}</strong></div>
    <div class="row success"><span>Your estimated profit</span><strong>${money(profit)}</strong></div>
    <div class="small">This is a starting calculator — you can overwrite the customer price when creating the quote.</div>
    <div class="actions"><button class="primary" onclick="usePrice(${sell.toFixed(2)})">Use this price for quote</button></div>`;
}

function usePrice(p){
  document.getElementById('sellPrice').value=p;
  show('quote',document.querySelectorAll('nav button')[2]);
}

function resetCalc(){
  ['balloons','balloonCost','foils','materials','labour','delivery','other','margin'].forEach((id,i)=>{
    document.getElementById(id).value=['30','.12','0','3','20','0','0','40'][i];
  });
  document.getElementById('calcResult').style.display='none';lastCalc=null;
}

function saveQuote(){
  const q={
    id:'MTYD-Q'+String(Date.now()).slice(-6),
    customer:document.getElementById('customer').value.trim()||'Unnamed customer',
    contact:document.getElementById('contact').value.trim(),
    eventDate:document.getElementById('eventDate').value,
    venue:document.getElementById('venue').value.trim(),
    price:val('sellPrice'),deposit:val('deposit'),
    notes:document.getElementById('notes').value.trim(),
    type:lastCalc?.type||'Custom',
    cost:lastCalc?.cost||0,
    profit:lastCalc ? val('sellPrice')-lastCalc.cost : val('sellPrice'),
    created:new Date().toISOString()
  };
  quotes.unshift(q);localStorage.setItem(key,JSON.stringify(quotes));updateDash();
  document.getElementById('quotePreview').style.display='block';
  document.getElementById('quotePreview').innerHTML='<strong>Saved!</strong> '+q.id+' has been saved on this device.';
  renderJobs();
}

function makeQuoteText(){
  const customer=document.getElementById('customer').value||'Customer';
  const price=val('sellPrice'), deposit=val('deposit');
  const balance=Math.max(0,price-deposit);
  const text=`ME TO YOU DESIGNS 🎈

BALLOON QUOTE

Customer: ${customer}
Event date: ${document.getElementById('eventDate').value||'TBC'}
Venue: ${document.getElementById('venue').value||'TBC'}

Package: ${lastCalc?.type||'Custom'}
Price: ${money(price)}
Deposit: ${money(deposit)}
Balance: ${money(balance)}

${document.getElementById('notes').value||''}

Thank you for choosing Me To You Designs.`;
  const box=document.getElementById('quotePreview');
  box.style.display='block';
  box.innerHTML='<div class="quote">'+text.replaceAll('&','&amp;').replaceAll('<','&lt;')+'</div><div class="actions"><button class="secondary" onclick="window.print()">Print / Save PDF</button></div>';
}

function renderJobs(){
  const box=document.getElementById('jobsList');
  if(!quotes.length){box.innerHTML='<div class="card">No saved quotes yet.</div>';return}
  box.innerHTML=quotes.map(q=>`
    <div class="card" style="margin-bottom:10px">
      <div class="row"><strong>${escapeHtml(q.customer)}</strong><strong>${money(q.price)}</strong></div>
      <div class="small">${q.id} · ${q.type} · ${q.eventDate||'Date TBC'}</div>
      <div class="row"><span>Deposit</span><strong>${money(q.deposit)}</strong></div>
      <div class="row"><span>Balance</span><strong>${money(Math.max(0,q.price-q.deposit))}</strong></div>
      <div class="actions"><button class="secondary" onclick="deleteQuote('${q.id}')">Delete</button></div>
    </div>`).join('');
}

function deleteQuote(id){
  quotes=quotes.filter(q=>q.id!==id);localStorage.setItem(key,JSON.stringify(quotes));renderJobs();updateDash();
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function updateDash(){
  document.getElementById('quoteCount').textContent=quotes.length;
  document.getElementById('jobCount').textContent=quotes.filter(q=>q.eventDate).length;
  document.getElementById('quoteTotal').textContent=money(quotes.reduce((a,q)=>a+q.price,0));
}
updateDash();
</script>
</body>
</html>
